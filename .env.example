# Cloudflare Web Analytics Beacon Token
# 获取方式: Cloudflare Dash → 域名 → Analytics → Web Analytics → 启用 → 复制 token
# 设为 __CF_TOKEN__ 则禁用 CF 统计
NEXT_PUBLIC_CF_BEACON_TOKEN=__CF_TOKEN__

# Football-data.org API Token (免费: 10请求/分钟)
# 注册地址: https://www.football-data.org/client/register
# 配置后自动拉取实时比分和积分榜。留空则使用内置模拟数据。
NEXT_PUBLIC_FOOTBALL_DATA_TOKEN=YOUR_TOKEN_HERE
